# Required: Anthropic API key for AI resolver and converters
ANTHROPIC_API_KEY=sk-ant-...

# Jam integration (for importing recordings)
JAM_ACCESS_TOKEN=jam_pat_...

# Auth method: "interactive" (default) — open browser, log in manually, state is cached
AUTH_METHOD=interactive

# Auth email for pre-login setup
AUTH_EMAIL=

# Sentry
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENV=development

# Environment URLs (can also be managed via API)
ENV_DEV_URL=https://dev-prism.upcover.com/
ENV_STAGING_URL=https://staging-prism.upcover.com/
ENV_PROD_URL=https://prism.upcover.com/

# Playwright (optional — auto-detects system Node if unset)
PLAYWRIGHT_BROWSERS_PATH=/Users/you/.cache/ms-playwright
# PLAYWRIGHT_NODEJS_PATH=/Users/you/.nvm/versions/node/v22.14.0/bin/node
